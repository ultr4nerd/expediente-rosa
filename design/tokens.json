{
  "$description": "Expediente Rosa: a warm, clinical system. Brand pink measured from EIRA's website (design/references/eira-sitio-web.md); everything else is the product's own direction.",
  "primitive": {
    "$description": "Raw palette and font families. Never used in code; semantic tokens reference them.",
    "color": {
      "$type": "color",
      "neutral": {
        "0": {
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
        },
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9882, 0.9725, 0.9647], "hex": "#fcf8f6" }
        },
        "100": {
          "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9333, 0.9176], "hex": "#f5eeea" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.9098, 0.8667, 0.8431], "hex": "#e8ddd7" }
        },
        "300": {
          "$value": { "colorSpace": "srgb", "components": [0.8392, 0.7843, 0.7569], "hex": "#d6c8c1" }
        },
        "500": {
          "$value": { "colorSpace": "srgb", "components": [0.5216, 0.4667, 0.4392], "hex": "#857770" }
        },
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.4196, 0.3686, 0.3451], "hex": "#6b5e58" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.3216, 0.2824, 0.2627], "hex": "#524843" }
        },
        "800": {
          "$value": { "colorSpace": "srgb", "components": [0.2392, 0.2039, 0.1922], "hex": "#3d3431" }
        },
        "900": {
          "$value": { "colorSpace": "srgb", "components": [0.1647, 0.1333, 0.1255], "hex": "#2a2220" }
        },
        "$description": "Warm neutrals (stone gray with a pink tint), not cold hospital grays."
      },
      "rosa": {
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9451, 0.9569], "hex": "#fdf1f4" }
        },
        "100": {
          "$value": { "colorSpace": "srgb", "components": [0.9843, 0.8824, 0.9098], "hex": "#fbe1e8" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.9608, 0.7647, 0.8196], "hex": "#f5c3d1" }
        },
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.7176, 0.2588, 0.4235], "hex": "#b7426c" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.5961, 0.2078, 0.349], "hex": "#983559" }
        },
        "800": {
          "$value": { "colorSpace": "srgb", "components": [0.4784, 0.1647, 0.2784], "hex": "#7a2a47" }
        },
        "$description": "Brand pink. 600 measured from eiraac.org CSS (buttons); the rest derived.",
        "$extensions": {
          "io.github.ultr4nerd.design": { "status": "provisional", "source": "design/references/eira-sitio-web.md" }
        }
      },
      "ciruela": {
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9373, 0.9608], "hex": "#f6eff5" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.8627, 0.7647, 0.8353], "hex": "#dcc3d5" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.4157, 0.1686, 0.3176], "hex": "#6a2b51" }
        },
        "$description": "Plum measured from eiraac.org CSS; used for focus and autofill.",
        "$extensions": {
          "io.github.ultr4nerd.design": { "status": "provisional", "source": "design/references/eira-sitio-web.md" }
        }
      },
      "verde": {
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9176, 0.9608, 0.9333], "hex": "#eaf5ee" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.7255, 0.8627, 0.7725], "hex": "#b9dcc5" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.1294, 0.4039, 0.2471], "hex": "#21673f" }
        }
      },
      "ambar": {
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9529, 0.8627], "hex": "#fdf3dc" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.9529, 0.8353, 0.5608], "hex": "#f3d58f" }
        },
        "500": {
          "$value": { "colorSpace": "srgb", "components": [0.7255, 0.4706, 0], "hex": "#b97800" }
        },
        "800": {
          "$value": { "colorSpace": "srgb", "components": [0.4784, 0.2902, 0], "hex": "#7a4a00" }
        }
      },
      "rojo": {
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9255, 0.9216], "hex": "#fdeceb" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.9569, 0.7529, 0.7333], "hex": "#f4c0bb" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.6902, 0.1569, 0.1137], "hex": "#b0281d" }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Atkinson Hyperlegible Next Variable",
          "Atkinson Hyperlegible Next",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Atkinson Hyperlegible Next (OFL, Braille Institute), bundled with @fontsource-variable."
      },
      "display": {
        "$value": ["Montserrat Variable", "Montserrat", "Segoe UI", "system-ui", "sans-serif"],
        "$description": "Montserrat (OFL), the typeface of EIRA's website; bundled with @fontsource-variable."
      }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{primitive.color.neutral.50}",
      "$description": "App background (warm cream)"
    },
    "surface-raised": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Cards, dialogs, menus, form fields"
    },
    "surface-sunken": {
      "$value": "{primitive.color.neutral.100}",
      "$description": "Sunken areas: sidebars, alternating rows, data hidden by role"
    },
    "on-surface": {
      "$value": "{primitive.color.neutral.900}",
      "$description": "Primary text and icons",
      "$extensions": {
        "io.github.ultr4nerd.design": {
          "on": { "color.surface": "AAA", "color.surface-raised": "AAA", "color.surface-sunken": "AAA" }
        }
      }
    },
    "on-surface-muted": {
      "$value": "{primitive.color.neutral.600}",
      "$description": "Secondary text: hints, metadata, placeholders",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised", "color.surface-sunken"] }
      }
    },
    "border": {
      "$value": "{primitive.color.neutral.200}",
      "$description": "Dividers and card borders (decorative, no contrast minimum)"
    },
    "input": {
      "$value": "{primitive.color.neutral.500}",
      "$description": "Resting field border (UI component, 3:1)",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": { "color.surface": "ui", "color.surface-raised": "ui" } }
      }
    },
    "primary": {
      "$value": "{primitive.color.rosa.600}",
      "$description": "Primary action (one per screen), active selection, brand accents"
    },
    "primary-hover": {
      "$value": "{primitive.color.rosa.700}",
      "$description": "Primary action on hover or press"
    },
    "on-primary": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Text and icons on primary"
    },
    "secondary": {
      "$value": "{primitive.color.rosa.50}",
      "$description": "Secondary actions and soft brand chips"
    },
    "on-secondary": {
      "$value": "{primitive.color.rosa.800}",
      "$description": "Text on secondary"
    },
    "highlight": {
      "$value": "{primitive.color.rosa.100}",
      "$description": "Hover for options in menus and lists, selected row"
    },
    "on-highlight": {
      "$value": "{primitive.color.rosa.800}",
      "$description": "Text on highlight"
    },
    "brand-text": {
      "$value": "{primitive.color.rosa.700}",
      "$description": "Brand pink text (links, highlighted figures); never long paragraphs",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised", "color.secondary"] }
      }
    },
    "focus": {
      "$value": "{primitive.color.ciruela.700}",
      "$description": "Keyboard focus ring on every interactive element",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": { "color.surface": "ui", "color.surface-raised": "ui" } }
      }
    },
    "danger": {
      "$value": "{primitive.color.rojo.700}",
      "$description": "Destructive actions, errors, 'conflict' sync state",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "on-danger": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Text on danger"
    },
    "danger-subtle": {
      "$value": "{primitive.color.rojo.50}",
      "$description": "Background of error notices and the 'conflict' badge"
    },
    "on-danger-subtle": {
      "$value": "{primitive.color.rojo.700}",
      "$description": "Text on danger-subtle"
    },
    "danger-border": {
      "$value": "{primitive.color.rojo.200}",
      "$description": "Border of error notices (decorative)"
    },
    "success": {
      "$value": "{primitive.color.verde.700}",
      "$description": "Success; 'synced' sync state",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "success-subtle": {
      "$value": "{primitive.color.verde.50}",
      "$description": "Background of the 'synced' badge and confirmations"
    },
    "on-success-subtle": {
      "$value": "{primitive.color.verde.700}",
      "$description": "Text on success-subtle"
    },
    "success-border": {
      "$value": "{primitive.color.verde.200}",
      "$description": "Border of success badges (decorative)"
    },
    "warning": {
      "$value": "{primitive.color.ambar.500}",
      "$description": "Warning dot or icon; 'pending sync' state (fill, never text)",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": { "color.surface": "ui", "color.surface-raised": "ui" } }
      }
    },
    "warning-subtle": {
      "$value": "{primitive.color.ambar.50}",
      "$description": "Background of warnings, the 'pending' badge and the provisional folio"
    },
    "on-warning-subtle": {
      "$value": "{primitive.color.ambar.800}",
      "$description": "Warning text and provisional folio text",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "warning-border": {
      "$value": "{primitive.color.ambar.800}",
      "$description": "Dashed border of the provisional folio (UI, 3:1)",
      "$extensions": { "io.github.ultr4nerd.design": { "on": { "color.warning-subtle": "ui" } } }
    },
    "offline": {
      "$value": "{primitive.color.neutral.800}",
      "$description": "'Sin conexión' (offline) banner and 'no network' sync state"
    },
    "on-offline": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Text on offline"
    },
    "autofill": {
      "$value": "{primitive.color.ciruela.50}",
      "$description": "Background of fields autofilled from history, not yet confirmed"
    },
    "on-autofill": {
      "$value": "{primitive.color.ciruela.700}",
      "$description": "Text of the 'Del historial' label on autofill"
    },
    "autofill-border": {
      "$value": "{primitive.color.ciruela.700}",
      "$description": "Left border of autofilled fields (UI, 3:1)",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": { "color.autofill": "ui", "color.surface-raised": "ui" } }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": "{primitive.font.sans}",
      "$description": "Interface, form and data text"
    },
    "display": {
      "$value": "{primitive.font.display}",
      "$description": "Screen titles and wordmark"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": { "value": 4, "unit": "px" },
      "$description": "Icon with its label; minimal gaps"
    },
    "sm": {
      "$value": { "value": 8, "unit": "px" },
      "$description": "Between related elements; chip padding"
    },
    "md": {
      "$value": { "value": 16, "unit": "px" },
      "$description": "Card and control padding; space between fields"
    },
    "lg": {
      "$value": { "value": 24, "unit": "px" },
      "$description": "Between groups within a section"
    },
    "xl": {
      "$value": { "value": 32, "unit": "px" },
      "$description": "Between sections of a screen"
    },
    "2xl": {
      "$value": { "value": 48, "unit": "px" },
      "$description": "Margins of empty and home screens"
    },
    "cartilla-w": {
      "$value": { "value": 324, "unit": "px" },
      "$description": "Printed Cartilla EIRA card width: 85.6 mm (ID-1 card) at 96 px per inch"
    },
    "cartilla-h": {
      "$value": { "value": 204, "unit": "px" },
      "$description": "Printed Cartilla EIRA card height: 54 mm (ID-1 card) at 96 px per inch"
    },
    "cartilla-qr": {
      "$value": { "value": 112, "unit": "px" },
      "$description": "QR on the Cartilla EIRA card: about 30 mm, scannable by a phone at arm's length"
    },
    "control": {
      "$value": { "value": 44, "unit": "px" },
      "$description": "Minimum height of buttons, inputs and selects (click target)"
    },
    "control-lg": {
      "$value": { "value": 52, "unit": "px" },
      "$description": "Height of a form's primary action (Guardar, Registrar)"
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": { "value": 10, "unit": "px" },
      "$description": "Buttons, inputs, chips (this is shadcn's --radius)"
    },
    "card": {
      "$value": { "value": 14, "unit": "px" },
      "$description": "Cards, dialogs, panels"
    },
    "pill": {
      "$value": { "value": 9999, "unit": "px" },
      "$description": "Status badges, avatars"
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.1647, 0.1333, 0.1255],
            "alpha": 0.102,
            "hex": "#2a2220"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.1647, 0.1333, 0.1255],
            "alpha": 0.0588,
            "hex": "#2a2220"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 12, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ],
      "$description": "Cards over the background"
    },
    "overlay": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.1647, 0.1333, 0.1255],
            "alpha": 0.1216,
            "hex": "#2a2220"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.1647, 0.1333, 0.1255],
            "alpha": 0.0784,
            "hex": "#2a2220"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 6, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ],
      "$description": "Dialogs, menus and toasts floating over the screen"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1],
      "$description": "Almost all transitions"
    },
    "exit": {
      "$value": [0.4, 0, 1, 1],
      "$description": "Exiting elements"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": { "value": 120, "unit": "ms" },
        "$description": "Hover and press"
      },
      "base": {
        "$value": { "value": 200, "unit": "ms" },
        "$description": "Opening menus, dialogs, toasts"
      }
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 32, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": { "value": -0.5, "unit": "px" }
      },
      "$description": "Home screen and large empty states"
    },
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 24, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.25
      },
      "$description": "Screen and dialog titles"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 19, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "$description": "Section and card headings"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "Running text and field values"
    },
    "body-strong": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.5
      },
      "$description": "Patient name, key data within text"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.35
      },
      "$description": "Buttons, field labels, tabs"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 14, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$description": "Hints, metadata, badges (the app's minimum size)"
    },
    "folio": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 18, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.2,
        "letterSpacing": { "value": 0.5, "unit": "px" }
      },
      "$description": "Patient folio (provisional A-0007 or final 2026-0143); use with tabular-nums"
    }
  }
}
